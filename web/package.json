{
  "name": "cawg-viewer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "wasm": "../scripts/build-wasm.sh",
    "wasm:dev": "../scripts/build-wasm.sh --dev",
    "dev": "vite --mode static",
    "dev:full": "vite --mode full",
    "build:static": "npm run typecheck && vite build --mode static --outDir dist/static && node scripts/precompress.mjs dist/static",
    "build:full": "npm run typecheck && vite build --mode full --outDir dist/full && node scripts/precompress.mjs dist/full",
    "preview:static": "vite preview --mode static --outDir dist/static",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "c2pa-react-cawg-component": "^0.1.16",
    "c2pa-react-component": "^0.1.22",
    "c2pa-react-component-types": "^0.1.5",
    "comlink": "^4.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
